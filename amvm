#!/usr/bin/env bash
set -euo pipefail

DEFAULT_AMVM_ROOT="$HOME/.amvm"
AMVM_ROOT="$DEFAULT_AMVM_ROOT"
CONFIG_FILE="$HOME/.amvm.cfg"

AMVM_VERSION="2.0.0"
AMVM_DEFAULT_PYTHON_VERSION="3.12"
AMVM_METADATA_FILE=".amvm.env"
AMVM_CUSTOM_VERSIONS=()
AMVM_BUILTIN_VERSIONS=(
  "10:10.7.0|2.17.14|25.8.2|0.3.50|3.12"
  "11:11.13.0|2.18.18|25.11.0|0.3.50|3.12"
  "12:12.3.0|2.19.11|26.4.0|0.3.50|3.12"
  "13:13.8.0|2.20.7|26.6.0|0.3.50|3.12"
  "14:14.1.0|2.21.1|26.6.0|0.3.50|3.12"
)

C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_CYAN='\033[0;36m'

c_info() { printf "%b%s%b\n" "${C_CYAN}" "$1" "${C_RESET}"; }
c_ok() { printf "%b%s%b\n" "${C_GREEN}" "$1" "${C_RESET}"; }
c_warn() { printf "%b%s%b\n" "${C_YELLOW}" "$1" "${C_RESET}"; }
c_err() { printf "%bError: %s%b\n" "${C_RED}" "$1" "${C_RESET}" >&2; }
die() { c_err "$1"; exit 1; }

get_version_data() {
  local key_to_find="$1"
  local item
  for item in "${AMVM_BUILTIN_VERSIONS[@]}"; do
    if [[ "${item%%:*}" == "$key_to_find" ]]; then echo "${item#*:}"; return 0; fi
  done
  return 1
}

get_all_versions() {
  local item
  for item in "${AMVM_BUILTIN_VERSIONS[@]}"; do echo -n "${item%%:*} "; done
}

parse_version_string() {
  local version_string="$1"
  local extra=""
  IFS='|' read -r ansible_ver core_ver lint_ver mitogen_ver python_ver extra <<<"$version_string"
  python_ver="${python_ver:-$AMVM_DEFAULT_PYTHON_VERSION}"

  if [[ -n "$extra" ]]; then
    die "Invalid version string '$version_string': expected KEY:ansible|ansible-core|ansible-lint|mitogen[|python]."
  fi
  if [[ -z "$ansible_ver" || -z "$core_ver" || -z "$lint_ver" || -z "$mitogen_ver" ]]; then
    die "Invalid version string '$version_string': expected KEY:ansible|ansible-core|ansible-lint|mitogen[|python]."
  fi
}

normalize_version_string() {
  local version_string="$1"
  local ansible_ver core_ver lint_ver mitogen_ver python_ver
  parse_version_string "$version_string"
  printf "%s|%s|%s|%s|%s\n" "$ansible_ver" "$core_ver" "$lint_ver" "$mitogen_ver" "$python_ver"
}

get_builtin_key_for_ansible_version() {
  local ansible_to_find="$1"
  local item key ansible_ver core_ver lint_ver mitogen_ver python_ver
  for item in "${AMVM_BUILTIN_VERSIONS[@]}"; do
    key="${item%%:*}"
    parse_version_string "${item#*:}"
    if [[ "$ansible_ver" == "$ansible_to_find" ]]; then echo "$key"; return 0; fi
  done
  return 1
}

get_version_note() {
  case "$1" in
    10) echo "EOL; final 10.x package";;
    11) echo "EOL Dec 2025; strict-era lint";;
    12) echo "EOL Dec 2025; strict-era lint";;
    13) echo "Final Ansible 13/core 2.20 line";;
    14) echo "Current tested Ansible 14/core 2.21 line";;
    *) echo "";;
  esac
}

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then source "$CONFIG_FILE"; fi
  AMVM_ROOT="${AMVM_ROOT/#\~/$HOME}"
}

ensure_dirs() {
  mkdir -p "$AMVM_ROOT" "$AMVM_ROOT/bin"
}

ensure_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    die "amvm 2.0 requires 'uv' in PATH. Install uv first: https://docs.astral.sh/uv/getting-started/installation/"
  fi
}

detect_shell_profile() {
  local shell_name
  shell_name=$(basename "${SHELL:-bash}")
  case "$shell_name" in
    bash) echo "$HOME/.bashrc";;
    zsh) echo "$HOME/.zshrc";;
    *) echo "your_shell_profile_file";;
  esac
}

check_path_and_warn() {
  local shim_dir="$AMVM_ROOT/bin"
  case ":$PATH:" in
    *":$shim_dir:"*) ;;
    *)
      local profile_file
      profile_file=$(detect_shell_profile)
      c_warn "⚠️  Warning: Directory '$shim_dir' is not in your \$PATH."
      c_warn "   To use your installed Ansible versions, add it to your shell profile."
      printf "   Run this command and restart your terminal:\n"
      printf "   %s\n" "echo 'export PATH=\"${shim_dir}:\$PATH\"' >> \"${profile_file}\""
      echo
      ;;
  esac
}

print_usage() {
  cat <<EOF
amvm (Ansible with Mitogen Version Manager)

Manages installations and switching of Ansible versions.

USAGE:
  amvm [COMMAND] [ARGUMENTS]

COMMANDS:
  (no command)          Show an interactive menu to switch the active version.
  --install <ver>       Install a built-in Ansible version.
                        <ver> can be: $(get_all_versions | sed 's/ /, /g; s/, $//'), or all.
  --reinstall <ver>     Remove and reinstall a built-in Ansible version.
                        <ver> can be: $(get_all_versions | sed 's/ /, /g; s/, $//'), or all.
  --install-custom <k>  Install a user-defined version by its key from ~/.amvm.cfg.
  --matrix              Print the built-in compatibility matrix.
  --uninstall           Interactively uninstall a specific version.
  --list                List all installed versions.
  --cleanup             Remove ALL amvm environments, shims, and configurations.
  --help, -h            Show this help message.
  --version, -v         Show version.
EOF
}

print_version() {
  printf "amvm v%s\n" "$AMVM_VERSION"
}

print_matrix() {
  local item key note ansible_ver core_ver lint_ver mitogen_ver python_ver
  printf "%-5s %-11s %-14s %-14s %-10s %-8s %s\n" "KEY" "ANSIBLE" "ANSIBLE-CORE" "ANSIBLE-LINT" "MITOGEN" "PYTHON" "NOTES"
  printf "%-5s %-11s %-14s %-14s %-10s %-8s %s\n" "---" "-------" "------------" "------------" "-------" "------" "-----"
  for item in "${AMVM_BUILTIN_VERSIONS[@]}"; do
    key="${item%%:*}"
    parse_version_string "${item#*:}"
    note=$(get_version_note "$key")
    printf "%-5s %-11s %-14s %-14s %-10s %-8s %s\n" "$key" "$ansible_ver" "$core_ver" "$lint_ver" "$mitogen_ver" "$python_ver" "$note"
  done
}

_metadata_value() {
  local metadata_file="$1"
  local key="$2"
  awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1); exit }' "$metadata_file" 2>/dev/null
}

_write_install_metadata() {
  local venv_dir="$1"
  local version_key="$2"
  local ansible_ver="$3"
  local core_ver="$4"
  local lint_ver="$5"
  local mitogen_ver="$6"
  local python_ver="$7"
  local metadata_file="$venv_dir/$AMVM_METADATA_FILE"

  {
    printf "amvm_version=%s\n" "$AMVM_VERSION"
    printf "key=%s\n" "$version_key"
    printf "ansible=%s\n" "$ansible_ver"
    printf "ansible_core=%s\n" "$core_ver"
    printf "ansible_lint=%s\n" "$lint_ver"
    printf "mitogen=%s\n" "$mitogen_ver"
    printf "python=%s\n" "$python_ver"
    printf "installer=uv\n"
  } >"$metadata_file"
}

_environment_matches() {
  local venv_dir="$1"
  local version_string="$2"
  local ansible_ver core_ver lint_ver mitogen_ver python_ver
  local metadata_file="$venv_dir/$AMVM_METADATA_FILE"

  [[ -f "$metadata_file" ]] || return 1
  parse_version_string "$version_string"

  [[ "$(_metadata_value "$metadata_file" ansible)" == "$ansible_ver" ]] || return 1
  [[ "$(_metadata_value "$metadata_file" ansible_core)" == "$core_ver" ]] || return 1
  [[ "$(_metadata_value "$metadata_file" ansible_lint)" == "$lint_ver" ]] || return 1
  [[ "$(_metadata_value "$metadata_file" mitogen)" == "$mitogen_ver" ]] || return 1
  [[ "$(_metadata_value "$metadata_file" python)" == "$python_ver" ]] || return 1
  [[ "$(_metadata_value "$metadata_file" installer)" == "uv" ]] || return 1
}

_describe_installed_environment() {
  local env_name="$1"
  local venv_dir="$AMVM_ROOT/$env_name"
  local metadata_file="$venv_dir/$AMVM_METADATA_FILE"
  local ansible_installed="${env_name#ansible-}"
  local key desired metadata_key

  if [[ -f "$metadata_file" ]]; then
    metadata_key=$(_metadata_value "$metadata_file" key)
    if [[ -n "$metadata_key" ]]; then
      if desired=$(get_version_data "$metadata_key" 2>/dev/null); then
        if _environment_matches "$venv_dir" "$desired"; then
          printf "%s" "built-in $metadata_key"
        else
          printf "%s" "stale built-in $metadata_key; run: amvm --reinstall $metadata_key"
        fi
      else
        printf "%s" "custom $metadata_key"
      fi
    else
      printf "%s" "metadata present"
    fi
    return
  fi

  key=$(get_builtin_key_for_ansible_version "$ansible_installed" || true)

  if [[ -n "$key" ]]; then
    desired=$(get_version_data "$key")
    if _environment_matches "$AMVM_ROOT/$env_name" "$desired"; then
      printf "%s" "built-in $key"
    else
      printf "%s" "stale built-in $key; run: amvm --reinstall $key"
    fi
  else
    printf "%s" "legacy or custom"
  fi
}

_get_installed_versions() {
  local installed=()
  local d
  while IFS= read -r -d '' d; do
    installed+=("$(basename "$d")")
  done < <(find "$AMVM_ROOT" -mindepth 1 -maxdepth 1 -type d -name "ansible-*" -print0 2>/dev/null)

  if [[ ${#installed[@]} -gt 0 ]]; then
    if sort -V </dev/null >/dev/null 2>&1; then
      printf "%s\n" "${installed[@]}" | sort -t- -k2 -Vr
    else
      printf "%s\n" "${installed[@]}" | sort -r
    fi
  fi
}

_remove_environment_dir() {
  local venv_name="$1"
  local venv_dir="$AMVM_ROOT/$venv_name"
  if [[ -d "$venv_dir" ]]; then
    c_info "Removing environment: $venv_name..."
    rm -rf "$venv_dir"
  fi
}

_perform_install() {
  local version_string="$1"
  local version_key="${2:-custom}"
  local normalized_version_string ansible_ver core_ver lint_ver mitogen_ver python_ver
  normalized_version_string=$(normalize_version_string "$version_string")
  parse_version_string "$normalized_version_string"

  if [[ -z "$ansible_ver" || "$ansible_ver" == "0" || -z "$core_ver" || "$core_ver" == "0" ]]; then
    die "Invalid version string: ansible and ansible-core versions are mandatory."
  fi

  ensure_uv
  ensure_dirs

  local venv_name="ansible-${ansible_ver}"
  local venv_dir="$AMVM_ROOT/${venv_name}"

  if [[ -d "$venv_dir" ]]; then
    if _environment_matches "$venv_dir" "$normalized_version_string"; then
      c_warn "Environment '$venv_name' already exists and matches the requested matrix. Skipping."
    else
      c_warn "Environment '$venv_name' already exists but does not match the requested matrix."
      local builtin_version_data=""
      if builtin_version_data=$(get_version_data "$version_key" 2>/dev/null) && [[ "$(normalize_version_string "$builtin_version_data")" == "$normalized_version_string" ]]; then
        c_warn "Run 'amvm --reinstall $version_key' to rebuild it with uv and current pins."
      else
        c_warn "Remove it with 'amvm --uninstall' before reinstalling the custom entry."
      fi
    fi
    return
  fi

  trap 'c_err "Installation of $venv_name failed. Cleaning up..."; rm -rf "$venv_dir";' ERR INT TERM

  c_info "=== Creating uv-managed environment: $venv_name (Python $python_ver) ==="
  uv venv --managed-python --python "$python_ver" "$venv_dir"

  c_info "--- Installing packages for Ansible $ansible_ver ---"
  local packages_to_install=("cffi" "jmespath" "boto3" "pywinrm" "ansible==${ansible_ver}" "ansible-core==${core_ver}")
  if [[ "$lint_ver" != "0" ]]; then packages_to_install+=("ansible-lint==${lint_ver}"); fi
  if [[ "$mitogen_ver" != "0" ]]; then packages_to_install+=("mitogen==${mitogen_ver}"); fi
  uv pip install --python "$venv_dir/bin/python" "${packages_to_install[@]}"

  c_info "--- Writing configuration files ---"
  local cache_dir="/tmp/${venv_name}-cache"
  cat <<EOL >"$venv_dir/ansible.cfg"
[defaults]
gathering = smart
fact_caching = jsonfile
fact_caching_connection = ${cache_dir}
forks = 10
EOL

  if [[ "$mitogen_ver" != "0" ]]; then
    c_info "--- Locating Mitogen strategy plugin path ---"
    local site_packages
    site_packages=$("$venv_dir/bin/python" -c 'import site; print(site.getsitepackages()[0])')
    local mitogen_path
    mitogen_path=$(find "$site_packages" -type d -name 'ansible_mitogen' | head -n1)/plugins/strategy
    if [[ ! -d "$mitogen_path" ]]; then
      c_warn "Could not find Mitogen strategy plugin. Mitogen config will not be created."
    else
      c_info "Mitogen plugin found at: $mitogen_path"
      cat <<EOL >"$venv_dir/ansible-mitogen.cfg"
[defaults]
strategy_plugins = ${mitogen_path}
strategy = mitogen_linear
gathering = smart
fact_caching = jsonfile
fact_caching_connection = ${cache_dir}
forks = 10
EOL
    fi
  fi

  _write_install_metadata "$venv_dir" "$version_key" "$ansible_ver" "$core_ver" "$lint_ver" "$mitogen_ver" "$python_ver"
  c_ok "✅ Environment '$venv_name' created successfully."
  echo
  trap - ERR INT TERM
}

handle_install() {
  local arg_ver="${1:-}"
  if [[ -z "$arg_ver" ]]; then die "The '--install' command requires a version. Available: $(get_all_versions | sed 's/ /, /g; s/, $//'), or all."; fi
  if [[ "$arg_ver" == "all" ]]; then
    local major
    for major in $(get_all_versions); do _perform_install "$(get_version_data "$major")" "$major"; done
  else
    local version_data
    version_data=$(get_version_data "$arg_ver") || die "Unsupported built-in version '$arg_ver'. Available: $(get_all_versions | sed 's/ /, /g; s/, $//')."
    _perform_install "$version_data" "$arg_ver"
  fi
  c_ok "✅ Installation complete."
}

confirm_reinstall() {
  local label="$1"
  local response
  read -r -p "Remove and rebuild $label? [y/N] " response
  if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    c_info "✋ Reinstall cancelled."
    exit 0
  fi
}

handle_reinstall() {
  local arg_ver="${1:-}"
  if [[ -z "$arg_ver" ]]; then die "The '--reinstall' command requires a version. Available: $(get_all_versions | sed 's/ /, /g; s/, $//'), or all."; fi

  if [[ "$arg_ver" == "all" ]]; then
    c_warn "This will remove and rebuild every current built-in environment target:"
    local major version_data ansible_ver core_ver lint_ver mitogen_ver python_ver
    for major in $(get_all_versions); do
      version_data=$(get_version_data "$major")
      parse_version_string "$version_data"
      printf "  - ansible-%s (key %s)\n" "$ansible_ver" "$major"
    done
    confirm_reinstall "all built-in environments"
    for major in $(get_all_versions); do
      version_data=$(get_version_data "$major")
      parse_version_string "$version_data"
      _remove_environment_dir "ansible-${ansible_ver}"
      _perform_install "$version_data" "$major"
    done
  else
    local version_data ansible_ver core_ver lint_ver mitogen_ver python_ver
    version_data=$(get_version_data "$arg_ver") || die "Unsupported built-in version '$arg_ver'. Available: $(get_all_versions | sed 's/ /, /g; s/, $//')."
    parse_version_string "$version_data"
    c_warn "This will remove and rebuild ansible-${ansible_ver}."
    confirm_reinstall "ansible-${ansible_ver}"
    _remove_environment_dir "ansible-${ansible_ver}"
    _perform_install "$version_data" "$arg_ver"
  fi
  c_ok "✅ Reinstall complete."
}

handle_install_custom() {
  local key_to_install="${1:-}"
  if [[ -z "$key_to_install" ]]; then die "The '--install-custom' command requires a key."; fi
  if [[ ${#AMVM_CUSTOM_VERSIONS[@]} -eq 0 ]]; then die "No custom versions defined in ~/.amvm.cfg via AMVM_CUSTOM_VERSIONS array."; fi
  local version_string=""
  local item
  for item in "${AMVM_CUSTOM_VERSIONS[@]}"; do
    if [[ "${item%%:*}" == "$key_to_install" ]]; then version_string="${item#*:}"; break; fi
  done
  if [[ -z "$version_string" ]]; then die "Custom version key '$key_to_install' not found in ~/.amvm.cfg."; fi
  _perform_install "$version_string" "$key_to_install"
  c_ok "✅ Custom installation complete."
}

_link_ansible_shims() {
  local venv_dir="$1"
  local shim_dir="$AMVM_ROOT/bin"
  mkdir -p "$shim_dir"
  rm -f "$shim_dir"/ansible*
  local venv_bin="$venv_dir/bin"
  while IFS= read -r -d '' exe; do
    local shim="$shim_dir/$(basename "$exe")"
    local quoted_venv_bin quoted_exe
    printf -v quoted_venv_bin "%q" "$venv_bin"
    printf -v quoted_exe "%q" "$exe"
    cat <<EOL >"$shim"
#!/usr/bin/env bash
export PATH=${quoted_venv_bin}:\${PATH}
exec ${quoted_exe} "\$@"
EOL
    chmod +x "$shim"
  done < <(find "$venv_dir/bin" -maxdepth 1 \( -type f -o -type l \) -name "ansible*" -print0)
}

handle_switch() {
  local installed_versions_str
  installed_versions_str=$(_get_installed_versions)
  if [[ -z "$installed_versions_str" ]]; then
    c_warn "⚠️  No Ansible environments found in '$AMVM_ROOT'."
    c_info "To install one, run: amvm --install [$(get_all_versions | sed 's/ /|/g')all]"
    exit 1
  fi
  local dirs=()
  local line
  while IFS= read -r line; do dirs+=("$line"); done <<< "$installed_versions_str"
  local choices=()
  local v
  for v in "${dirs[@]}"; do
    choices+=("$v")
    if [[ -f "$AMVM_ROOT/$v/ansible-mitogen.cfg" ]]; then choices+=("$v (mitogen)"); fi
    if [[ -f "$AMVM_ROOT/$v/ansible-customized.cfg" ]]; then choices+=("$v (custom)"); fi
  done
  local selection
  if command -v fzf >/dev/null 2>&1; then
    selection=$(printf "%s\n" "${choices[@]}" | fzf --height=15 --reverse --prompt="amvm> ")
  else
    local i
    for i in "${!choices[@]}"; do printf "  %2d) %s\n" "$((i + 1))" "${choices[i]}"; done
    local num_selection
    read -r -p "Enter a number: " num_selection
    if ! [[ "$num_selection" =~ ^[0-9]+$ && "$num_selection" -ge 1 && "$num_selection" -le ${#choices[@]} ]]; then die "Invalid selection."; fi
    selection="${choices[num_selection - 1]}"
  fi
  if [[ -z "$selection" ]]; then c_info "✋ Selection cancelled."; exit 0; fi
  local use_mitogen=false; local use_custom=false; local base_name="$selection"
  if [[ "$selection" == *"(mitogen)" ]]; then use_mitogen=true; base_name="${selection% (mitogen)}"; fi
  if [[ "$selection" == *"(custom)" ]]; then use_custom=true; base_name="${selection% (custom)}"; fi
  local venv_dir="$AMVM_ROOT/$base_name"
  [[ -d "$venv_dir" ]] || die "Environment directory not found: $venv_dir"
  local target_cfg
  if [[ "$use_custom" == true ]]; then target_cfg="$venv_dir/ansible-customized.cfg";
  elif [[ "$use_mitogen" == true ]]; then target_cfg="$venv_dir/ansible-mitogen.cfg";
  else target_cfg="$venv_dir/ansible.cfg"; fi
  [[ -f "$target_cfg" ]] || die "Config file not found: $target_cfg"
  ln -sf "$target_cfg" "$HOME/.ansible.cfg"
  _link_ansible_shims "$venv_dir"
  local suffix=""
  if [[ "$use_custom" == true ]]; then suffix=" (custom)"; fi
  if [[ "$use_mitogen" == true ]]; then suffix=" (mitogen)"; fi
  c_ok "✅ Switched to '$base_name'$suffix"
  printf "   %-20s -> %s\n" "~/.ansible.cfg" "$(readlink -f "$HOME/.ansible.cfg" 2>/dev/null || readlink "$HOME/.ansible.cfg")"
  printf "   %-20s -> %s\n" "ansible --version" "$(ansible --version | head -n1)"
}

handle_uninstall() {
  local installed_versions_str
  installed_versions_str=$(_get_installed_versions)
  if [[ -z "$installed_versions_str" ]]; then c_warn "⚠️  No Ansible environments found to uninstall."; exit 1; fi
  local choices=()
  local line
  while IFS= read -r line; do choices+=("$line"); done <<< "$installed_versions_str"
  c_info "Select an environment to uninstall:"
  local version_to_remove
  if command -v fzf >/dev/null 2>&1; then
    version_to_remove=$(printf "%s\n" "${choices[@]}" | fzf --height=15 --reverse --prompt="uninstall> ")
  else
    local i
    for i in "${!choices[@]}"; do printf "  %2d) %s\n" "$((i + 1))" "${choices[i]}"; done
    local num_selection
    read -r -p "Enter a number: " num_selection
    if ! [[ "$num_selection" =~ ^[0-9]+$ && "$num_selection" -ge 1 && "$num_selection" -le ${#choices[@]} ]]; then die "Invalid selection."; fi
    version_to_remove="${choices[num_selection - 1]}"
  fi
  if [[ -z "$version_to_remove" ]]; then c_info "✋ Uninstall cancelled."; exit 0; fi
  local response
  read -r -p "Are you sure you want to PERMANENTLY remove '$version_to_remove'? [y/N] " response
  if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then c_info "✋ Uninstall cancelled."; exit 0; fi
  local venv_dir="$AMVM_ROOT/$version_to_remove"
  local shim_dir="$AMVM_ROOT/bin"
  local was_active=false
  if [[ -L "$shim_dir/ansible" ]] && [[ "$(readlink "$shim_dir/ansible")" == *"/$version_to_remove/"* ]]; then
    was_active=true
  fi
  c_info "Removing environment: $version_to_remove..."
  rm -rf "$venv_dir"
  if [[ "$was_active" == true ]]; then
    c_warn "The active version was removed. Cleaning up shims and config."
    rm -f "$shim_dir"/ansible*
    rm -f "$HOME/.ansible.cfg"
    c_warn "Run 'amvm' again to switch to another installed version."
  fi
  c_ok "✅ Environment '$version_to_remove' has been removed."
}

handle_list() {
  local installed_versions_str
  installed_versions_str=$(_get_installed_versions)
  if [[ -z "$installed_versions_str" ]]; then
    c_warn "⚠️  No Ansible environments found."
    c_info "To install one, run: amvm --install [$(get_all_versions | sed 's/ /|/g')all]"
    return
  fi
  c_info "Installed environments in '$AMVM_ROOT':"
  local env_name description
  while IFS= read -r env_name; do
    description=$(_describe_installed_environment "$env_name")
    printf "  - %-20s %s\n" "$env_name" "($description)"
  done <<< "$installed_versions_str"
}

handle_cleanup() {
  local installed_versions_str
  installed_versions_str=$(_get_installed_versions)
  if [[ ! -d "$AMVM_ROOT" ]] || [[ -z "$installed_versions_str" && -z "$(ls -A "$AMVM_ROOT/bin" 2>/dev/null)" ]]; then
      c_warn "⚠️  Nothing to clean up. Directory '$AMVM_ROOT' is empty or does not exist."
      rm -f "$HOME/.ansible.cfg"
      exit 0
  fi
  c_warn "The following items will be PERMANENTLY REMOVED:"
  if [[ -n "$installed_versions_str" ]]; then echo "$installed_versions_str" | sed "s#^#  - Environment: #"; fi
  echo "  - Shims directory: $AMVM_ROOT/bin"
  if [[ -e "$HOME/.ansible.cfg" ]]; then echo "  - Ansible config symlink: $HOME/.ansible.cfg"; fi
  echo
  local response
  read -r -p "Are you sure you want to remove all of the above? [y/N] " response
  if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then c_info "✋ Cleanup cancelled."; exit 0; fi
  c_info "Removing directory $AMVM_ROOT..."
  rm -rf "$AMVM_ROOT"
  c_info "Removing config file ~/.ansible.cfg..."
  rm -f "$HOME/.ansible.cfg"
  c_ok "✅ Cleanup complete."
  c_warn "Don't forget to remove the amvm PATH export from your shell profile."
}

main() {
  load_config
  local command=${1:-}
  case "$command" in
    --install|--install-custom|--reinstall|--uninstall|--list|--cleanup|--matrix|-h|--help|-v|--version) ;;
    *) check_path_and_warn;;
  esac
  local arg=${2:-}
  case "$command" in
  --install)          handle_install "$arg"; check_path_and_warn;;
  --reinstall)        handle_reinstall "$arg"; check_path_and_warn;;
  --install-custom)   handle_install_custom "$arg"; check_path_and_warn;;
  --matrix)           print_matrix;;
  --uninstall)        handle_uninstall;;
  --list)             handle_list;;
  --cleanup)          handle_cleanup;;
  "" | switch)        handle_switch;;
  -h | --help)        print_usage;;
  -v | --version)     print_version;;
  *)                  c_err "Unknown command: '$command'"; print_usage; exit 1;;
  esac
}

main "$@"
